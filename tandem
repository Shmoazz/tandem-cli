#!/usr/bin/env python3
"""tandem: a one-file command line client for Tandem (app.tandemai.io) requirements.

One file, standard library only, Python 3.9+, because the install promise is a curl
and a chmod; this gets structured internally, never split into modules.

A borrowed Chrome session's id token expires hourly, so that path mints a fresh one
from the refresh token on every run and never trusts the one in the page.
Cloudflare 1010s the default urllib User-Agent, so every request carries USER_AGENT.
Commands, auth setup and the API notes live in README.md.
"""
import argparse
import csv
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

BASE = "https://app.tandemai.io/api/v1"
COGNITO = "https://cognito-idp.us-east-1.amazonaws.com/"
USER_AGENT = "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) tandem-cli"
KEY_FILE = "~/.config/tandem/api_key"
STATUS_WORDS = {"draft": "draft", "in review": "review", "review": "review",
                "approved": "approved", "rejected": "rejected"}
NO_SESSION = ("No API key and no app.tandemai.io tab in Chrome: "
              "set TANDEM_API_KEY or open Tandem and log in.")
NO_PROGRAM = "No program id: pass -p PROGRAM_UUID or set TANDEM_PROGRAM."
NOTHING_TO_UPDATE = ("Nothing to update: pass at least one of "
                     "--name/--statement/--status/--owner/--parent.")


def tables_path(program):
    return "/programs/%s/req-tables" % program


def requirements_path(program, table_id):
    return "%s/%s/requirements" % (tables_path(program), table_id)


def normalize_status(value, unknown):
    # The API takes lowercase words while the UI shows "In Review"; `unknown` is what
    # an unrecognised word becomes, which is "draft" on create and itself on update.
    return STATUS_WORDS.get((value or "").strip().lower(), unknown)


def requirement_ids(rows):
    return {r["number"]: r["id"] for r in rows}


def choose_table(tables, ref):
    if ref:
        for t in tables:
            if t["id"] == ref or t["name"].lower() == ref.lower():
                return t
        sys.exit("No table named %r. Tables: %s" % (ref, ", ".join(t["name"] for t in tables)))
    if len(tables) == 1:
        return tables[0]
    sys.exit("Multiple tables, pick one with -t: %s" % ", ".join(t["name"] for t in tables))


def choose_program(flag, env_program, tab_program, programs=None):
    # `programs` is the account's list, which only the API key path has any reason to
    # fetch; the Chrome path passes None because the tab already named a program.
    named = flag or env_program or tab_program
    if named:
        return named
    if programs is None:
        sys.exit(NO_PROGRAM)
    if len(programs) == 1:
        return programs[0]["id"]
    sys.exit("Pick a program with -p or TANDEM_PROGRAM: "
             + ", ".join("%s (%s)" % (p.get("name"), p.get("id")) for p in programs))


def add_body(number, name, statement, status, owner, parent, existing, table_name):
    body = {"number": number, "name": name, "statement": statement,
            "status": normalize_status(status, "draft")}
    if owner:
        body["owner"] = owner
    if parent:
        parent_id = existing.get(parent)
        if not parent_id:
            sys.exit("Parent %r not found in table %s" % (parent, table_name))
        body["parent_id"] = parent_id
    return body


def update_body(name, statement, status, owner, parent, rows, table_name):
    # A key that is absent is left alone by the PUT, so only the flags that were
    # passed appear here, and "none" has to send an explicit null to unparent.
    body = {}
    if name is not None:
        body["name"] = name
    if statement is not None:
        body["statement"] = statement
    if status is not None:
        body["status"] = normalize_status(status, status)
    if owner is not None:
        body["owner"] = owner
    if parent is not None:
        if parent.lower() == "none":
            body["parent_id"] = None
        else:
            parent_id = requirement_ids(rows).get(parent)
            if not parent_id:
                sys.exit("Parent %r not found in table %s" % (parent, table_name))
            body["parent_id"] = parent_id
    if not body:
        sys.exit(NOTHING_TO_UPDATE)
    return body


def csv_row_body(row, default_owner, existing):
    # Returns (body, warning). A parent that is not in the table yet is a warning and a
    # top level row, never a failure, so one stale reference cannot strand a whole file.
    number = (row.get("Number") or "").strip()
    if not number:
        return None, None
    body = {"number": number,
            "name": (row.get("Name") or "").strip(),
            "statement": (row.get("Statement") or "").strip(),
            "status": normalize_status(row.get("Status") or "draft", "draft"),
            "owner": (row.get("Owner") or default_owner or "").strip()}
    if not body["owner"]:
        body.pop("owner")
    warning = None
    parent = (row.get("Parent") or "").strip()
    if parent in existing:
        body["parent_id"] = existing[parent]
    elif parent:
        warning = "warn: parent %s of %s not found; creating at top level" % (parent, number)
    return body, warning


def parse_chrome_session(body):
    body = (body or "").strip()
    if not body:
        sys.exit(NO_SESSION)
    data = json.loads(body)
    if not data.get("refresh") or not data.get("clientId"):
        sys.exit("Tandem tab found but no session: are you logged in?")
    return data["clientId"], data["refresh"], data.get("program")


class Auth:
    def __init__(self, api_key=None, token=None):
        self.api_key, self.token = api_key, token

    def headers(self):
        if self.api_key:
            return {"X-API-Key": self.api_key}
        return {"Authorization": "Bearer " + self.token}


def choose_auth(env, key_file_text):
    # An Auth for the key, or None meaning fall back to a Chrome session.
    key = (env.get("TANDEM_API_KEY") or "").strip()
    if not key:
        key = ((key_file_text or "").split("\n", 1)[0]).strip()
    return Auth(api_key=key) if key else None


def read_key_file(path=KEY_FILE):
    path = os.path.expanduser(path)
    if not os.path.exists(path):
        return None
    with open(path) as f:
        return f.read()


def resolve_auth(env, key_file_text, grab=None, mint=None):
    # Returns (auth, program named by the Chrome tab). `grab` and `mint` are injected
    # so a test can walk this without a Mac, a browser or the network.
    auth = choose_auth(env, key_file_text)
    if auth:
        return auth, None
    client_id, refresh, tab_program = (grab or chrome_grab)()
    return Auth(token=(mint or mint_token)(client_id, refresh)), tab_program


# The id token in localStorage expires hourly, so read the refresh token (good for
# weeks) and the Cognito client id instead and mint a fresh id token per run.
GRAB_JS = r"""
(function(){
  var prog=localStorage.getItem('tandem_current_program_id');
  var cid=null, rt=null;
  for(var i=0;i<localStorage.length;i++){
    var k=localStorage.key(i);
    var m=k.match(/CognitoIdentityServiceProvider\.([^.]+)\./);
    if(m) cid=m[1];
    if(/\.refreshToken$/.test(k)) rt=localStorage.getItem(k);
  }
  return JSON.stringify({clientId:cid, refresh:rt, program:prog});
})()
"""


def chrome_grab():
    script = '''
tell application "Google Chrome"
  repeat with w in windows
    repeat with t in tabs of w
      if (URL of t) contains "app.tandemai.io" then
        return execute t javascript "%s"
      end if
    end repeat
  end repeat
end tell
return ""
''' % GRAB_JS.replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")
    out = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit("Could not talk to Chrome: %s" % out.stderr.strip())
    return parse_chrome_session(out.stdout)


def mint_token(client_id, refresh):
    body = json.dumps({"AuthFlow": "REFRESH_TOKEN_AUTH", "ClientId": client_id,
                       "AuthParameters": {"REFRESH_TOKEN": refresh}}).encode()
    req = urllib.request.Request(COGNITO, data=body, method="POST")
    req.add_header("Content-Type", "application/x-amz-json-1.1")
    req.add_header("X-Amz-Target", "AWSCognitoIdentityProviderService.InitiateAuth")
    try:
        with urllib.request.urlopen(req) as r:
            tok = json.load(r).get("AuthenticationResult", {}).get("IdToken")
    except urllib.error.HTTPError as e:
        sys.exit("Token refresh failed: %s" % e.read().decode()[:300])
    if not tok:
        sys.exit("Token refresh returned no IdToken.")
    return tok


def api(method, path, auth, body=None):
    req = urllib.request.Request(BASE + path, method=method)
    for name, value in auth.headers().items():
        req.add_header(name, value)
    req.add_header("User-Agent", USER_AGENT)
    data = None
    if body is not None:
        req.add_header("Content-Type", "application/json")
        data = json.dumps(body).encode()
    try:
        with urllib.request.urlopen(req, data) as r:
            txt = r.read().decode()
    except urllib.error.HTTPError as e:
        sys.exit("API %s %s -> %d: %s" % (method, path, e.code, e.read().decode()[:300]))
    return json.loads(txt) if txt else None


def parse_args():
    ap = argparse.ArgumentParser(prog="tandem")
    ap.add_argument("-p", "--program", help="program UUID (default: current Chrome tab)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("programs")
    sub.add_parser("tables")
    p_ls = sub.add_parser("ls")
    p_ls.add_argument("-t", "--table")
    p_add = sub.add_parser("add")
    p_add.add_argument("-t", "--table")
    p_add.add_argument("-n", "--number", required=True)
    p_add.add_argument("--name", required=True)
    p_add.add_argument("--statement", required=True)
    p_add.add_argument("--status", default="draft")
    p_add.add_argument("--owner", default=os.environ.get("TANDEM_OWNER", ""))
    p_add.add_argument("--parent")
    p_imp = sub.add_parser("import")
    p_imp.add_argument("file")
    p_imp.add_argument("-t", "--table")
    p_imp.add_argument("--owner", default=os.environ.get("TANDEM_OWNER", ""))
    p_rm = sub.add_parser("rm")
    p_rm.add_argument("number")
    p_rm.add_argument("-t", "--table")
    p_rm.add_argument("--reason", required=True)
    p_up = sub.add_parser("update")
    p_up.add_argument("number")
    p_up.add_argument("-t", "--table")
    p_up.add_argument("--name")
    p_up.add_argument("--statement")
    p_up.add_argument("--status")
    p_up.add_argument("--owner")
    p_up.add_argument("--parent", help="parent requirement NUMBER, or 'none' to unparent")
    return ap.parse_args()


def main():
    args = parse_args()
    auth, tab_program = resolve_auth(os.environ, read_key_file())

    if args.cmd == "programs":
        for p in api("GET", "/programs", auth) or []:
            print("%s  %s" % (p.get("id"), p.get("name")))
        return

    env_program = os.environ.get("TANDEM_PROGRAM")
    programs = None
    if not (args.program or env_program or tab_program) and auth.api_key:
        programs = api("GET", "/programs", auth) or []
    program = choose_program(args.program, env_program, tab_program, programs)

    if args.cmd == "tables":
        for t in api("GET", tables_path(program), auth):
            print("%s  %s  (%s)" % (t["id"], t["name"], t.get("description") or ""))
        return

    table = choose_table(api("GET", tables_path(program), auth), args.table)
    reqs_path = requirements_path(program, table["id"])

    if args.cmd == "ls":
        rows = api("GET", reqs_path, auth)
        rows.sort(key=lambda r: (r.get("level", 0), r.get("sort_order", 0)))
        for r in rows:
            indent = "  " * r.get("level", 0)
            print("%-16s %-10s %s%s: %s" % (r["number"], r["status"], indent, r["name"],
                                            (r.get("statement") or "")[:70]))
        return

    if args.cmd == "add":
        existing = requirement_ids(api("GET", reqs_path, auth))
        body = add_body(args.number, args.name, args.statement, args.status,
                        args.owner, args.parent, existing, table["name"])
        created = api("POST", reqs_path, auth, body)
        print("created %s (%s)" % (created["number"], created["id"]))
        return

    if args.cmd == "update":
        rows = api("GET", reqs_path, auth)
        row = next((r for r in rows if r["number"] == args.number), None)
        if not row:
            sys.exit("No requirement %r in table %s" % (args.number, table["name"]))
        body = update_body(args.name, args.statement, args.status, args.owner,
                           args.parent, rows, table["name"])
        api("PUT", reqs_path + "/" + row["id"], auth, body)
        print("updated %s (%s)" % (args.number, ", ".join(body.keys())))
        return

    if args.cmd == "import":
        existing = requirement_ids(api("GET", reqs_path, auth))
        made, skipped = 0, 0
        with open(args.file, newline="") as f:
            for row in csv.DictReader(f):
                body, warning = csv_row_body(row, args.owner, existing)
                if not body:
                    continue
                if body["number"] in existing:
                    print("skip %s (already exists)" % body["number"])
                    skipped += 1
                    continue
                if warning:
                    print(warning)
                created = api("POST", reqs_path, auth, body)
                existing[body["number"]] = created["id"]
                made += 1
                print("created %s" % body["number"])
        print("done: %d created, %d skipped" % (made, skipped))
        return

    if args.cmd == "rm":
        req_id = requirement_ids(api("GET", reqs_path, auth)).get(args.number)
        if not req_id:
            sys.exit("No requirement %r in table %s" % (args.number, table["name"]))
        api("DELETE", reqs_path + "/" + req_id, auth, {"deletion_reason": args.reason})
        print("deleted %s" % args.number)
        return


if __name__ == "__main__":
    main()
